{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "space_dim:starfield",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/space_dim/star"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 900
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0, 0],
        "radius": 190,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 14
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initialization": {
        "per_init_expression": "v.star_size = math.random(0.35, 1.25); v.star_r = math.random(0.72, 1.0); v.star_g = math.random(0.78, 1.0); v.star_b = math.random(0.85, 1.0); v.star_a = math.random(0.45, 1.0);"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0, 0],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["v.star_size", "v.star_size"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.star_r",
          "v.star_g",
          "v.star_b",
          "v.star_a * math.clamp(math.sin((v.particle_age / v.particle_lifetime) * 180), 0, 1)"
        ]
      }
    }
  }
}
