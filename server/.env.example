# ---------------------------------------------------------------------------
# Copie para .env e ajuste.  Todas as variaveis sao lidas pelo docker-compose
# e repassadas para a imagem itzg/minecraft-bedrock-server.
# ---------------------------------------------------------------------------

# Imagem / versao do servidor -----------------------------------------------
IMAGE_TAG=latest
# LATEST = sempre a ultima versao publicada pela Mojang.
# Em producao prefira fixar, ex.: VERSION=1.21.44.01
VERSION=LATEST

# Identidade ----------------------------------------------------------------
SERVER_NAME=Dragon Forge Bedrock
LEVEL_NAME=world
# LEVEL_SEED=

# Regras de jogo ------------------------------------------------------------
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false
MAX_PLAYERS=10
DEFAULT_PLAYER_PERMISSION_LEVEL=member
# Mantenha true para exigir conta Xbox Live (recomendado).
ONLINE_MODE=true
WHITE_LIST=false

# Desempenho ----------------------------------------------------------------
VIEW_DISTANCE=16
TICK_DISTANCE=4
MEMORY_LIMIT=6g

# Rede ----------------------------------------------------------------------
SERVER_PORT=19132
SERVER_PORT_V6=19133

# Permissoes: XUIDs separados por virgula (nao gamertags).
# Descubra o XUID nos logs ao entrar: "Player connected: Fulano, xuid: 25330..."
# OPS=2533274792395639
# MEMBERS=
# VISITORS=

# Addons --------------------------------------------------------------------
# true forca o cliente a baixar o resource pack antes de entrar.
TEXTUREPACK_REQUIRED=false

# Dono dos arquivos em ./data (use o id do usuario do host: `id -u`, `id -g`)
PUID=1000
PGID=1000
